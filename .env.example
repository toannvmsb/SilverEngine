# SQLite for local/dev (zero setup). Swap to a postgresql:// URL in prisma/schema.prisma
# datasource block + here for production.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# --- Automated market data connectors (all optional — leave unset to keep
# using manual entry for that source; see src/lib/connectors/*.ts) ---

# FRED (free, self-service key): https://fred.stlouisfed.org/docs/api/api_key.html
# Powers: US 10Y real yield, broad-dollar-index change (macro component).
FRED_API_KEY=

# GoldAPI.io (free signup tier, no credit card): https://www.goldapi.io
# Powers: silver/gold spot -> feeds our own price history, which then
# drives realized vol / EWMA vol / drawdown once enough days accumulate.
GOLDAPI_KEY=

# Phu Quy domestic silver price — calls the JSON API their own frontend uses
# (no key needed). Leave unset/false to keep this disabled (manual entry
# stays required) — only set to "true" after confirming with Phu Quy/Legal
# that polling their internal API for this purpose is acceptable (section
# 4.2 scraper policy still applies even though it returns JSON, not HTML).
PHUQUY_QUOTE_API_ENABLED=false

# CFTC COT needs no key, but publicreporting.cftc.gov 403s connections from
# Vietnam (confirmed both via code and directly in-browser — likely a
# geo/IP-based block on their end, not fixable here). Off by default; try
# "true" only if running from somewhere the block may not apply (e.g. a
# US-hosted server).
CFTC_COT_ENABLED=false

# --- Scheduler (npm run scheduler) ---
INGESTION_INTERVAL_MINUTES=15
STRESS_TEST_INTERVAL_MINUTES=5

# --- Telegram alerts (optional) — see README "Cảnh báo Telegram" for setup ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
